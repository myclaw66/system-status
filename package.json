{
  "name": "system-status",
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes-powered Ubuntu ops agent: Docker monitor + public IP check + Feishu alert",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs'),path=require('path');function cp(s,d){if(!fs.existsSync(s))return;fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s)){const ss=path.join(s,e),dd=path.join(d,e);fs.statSync(ss).isDirectory()?cp(ss,dd):fs.copyFileSync(ss,dd)}}cp('src/web/public','dist/web/public')\"",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "dockerode": "^4.0.2",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
